{
    "name": "sharkyphp/annotation",
    "description": "SharkyPHP annotation component, provides native PHP attribute annotations for framework",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Sharky\\Annotation\\": "src"
        }
    },
    "authors": [
        {
            "name": "bytesharky",
            "email": "fish@doffish.com"
        }
    ],
    "require": {
        "php": ">=8.2",
        "sharkyphp/contracts": "^2.0.0"
    },
    "archive": {
        "exclude": [
            "docs/",
            "tests/",
            ".github/",
            ".gitignore",
            "composer.lock",
            "vendor/",
            ".env"
        ]
    }
}
